<?xml version="1.0" encoding="UTF-8"?>
<!--
    The suite that runs on MySQL.

    Separate from phpunit.xml on purpose: SQLite is what the everyday suite uses
    because it is instant and needs nothing installed, and a developer should not
    have to stand up a database server to run it. This configuration exists for
    the questions SQLite cannot answer, and it is deliberately not wired into the
    default run.

    The connection comes from .env.mysql-testing, or from the same variables
    exported in the shell. When it is not there, every test here skips rather
    than borrowing the application's own database.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/Mysql/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Mysql">
            <directory>tests/Mysql</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:ohJOG1ZtKzR8kK3VdYPMS7A5J2QaRnEAcQ0Yc3L1tFA="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>