# Connection for `composer test:mysql`.
#
# Copy to `.env.mysql-testing` and fill in. That file is gitignored: it holds
# credentials.
#
# This suite drops every table in the database below before it runs. It refuses
# to start unless the name contains "test", so point it at a database you are
# willing to lose -- not at the application's own.
#
# Copy DB_HOST, DB_PORT, DB_USERNAME and DB_PASSWORD from `.env`: the server
# this project talks to is often not on 3306. Change DB_DATABASE to a name of
# your own that ends in "test".

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=semi_erp_hotwheels_test
DB_USERNAME=root
DB_PASSWORD=